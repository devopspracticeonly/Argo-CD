{
  "title": "INC-005 Workload Health",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "panels": [
    {
      "id": 1,
      "title": "Available replicas",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "kube_deployment_status_replicas_available{namespace=\"payment-production\"}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "Desired replicas",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "kube_deployment_spec_replicas{namespace=\"payment-production\"}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "Pod readiness",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "kube_pod_status_ready{namespace=\"payment-production\",condition=\"true\"}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "Container restarts",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "kube_pod_container_status_restarts_total{namespace=\"payment-production\"}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "title": "CPU usage",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum by(pod)(rate(container_cpu_usage_seconds_total{namespace=\"payment-production\",container!=\"\"}[5m]))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "title": "Memory usage",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum by(pod)(container_memory_working_set_bytes{namespace=\"payment-production\",container!=\"\"})",
          "refId": "A"
        }
      ]
    }
  ]
}